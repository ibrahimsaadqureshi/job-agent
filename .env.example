# Local runs read ~/.config/job-agent/.env (outside the repo). In GitHub Actions these are
# repository secrets. Never put real values in this file.
# See PLAN.md section 6 for how to create each one.

# LLM: Google AI Studio key, free tier, no billing attached
GEMINI_API_KEY=
# gemini | github | ollama
LLM_PROVIDER=gemini
# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GitHub Models fallback: CI uses the built-in GITHUB_TOKEN (permissions: models: read).
# Locally, a fine-grained token with the models:read permission.
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
# OLLAMA_MODEL=qwen2.5:7b

# Google Sheet tracker: full service-account JSON on one line, and the Sheet id from its URL
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# Daily digest: Slack incoming webhook URL
SLACK_WEBHOOK_URL=

# Contact-stripped resume text. Locally you can instead set resume_path in ~/.config/job-agent/config.toml.
CANDIDATE_PROFILE=

# Tuning (optional)
SCORE_THRESHOLD=70
DIGEST_MAX_JOBS=12
# SCORE_BATCH_SIZE=10
# MAX_DRAFTS=12
# DESCRIPTION_CHARS=1000
# Default --limit: jobs scored per run, so a big backlog spreads over a few days
# MAX_SCORED_PER_RUN=200
