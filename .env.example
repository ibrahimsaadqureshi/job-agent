# Copy to .env (gitignored) for local runs. In GitHub Actions these are repository secrets.
# See PLAN.md section 6 for how to create each one.

# LLM: Google AI Studio key, free tier, no billing attached
GEMINI_API_KEY=
# gemini | github | ollama
LLM_PROVIDER=gemini

# Google Sheet tracker: full service-account JSON on one line, and the Sheet id from its URL
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# Daily digest: Slack incoming webhook URL
SLACK_WEBHOOK_URL=

# Contact-stripped resume text. Locally you can instead set resume_path in config.local.toml.
CANDIDATE_PROFILE=

# Tuning (optional)
SCORE_THRESHOLD=70
DIGEST_MAX_JOBS=12
